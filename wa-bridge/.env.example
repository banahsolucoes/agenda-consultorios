# Supabase (persistência do estado de sessão do Baileys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado com o app Next.js para assinatura HMAC (POST /enqueue e webhooks)
BRIDGE_SHARED_SECRET=

# Segredo simples para proteger GET /qr e GET /status (header x-bridge-secret)
BRIDGE_ADMIN_SECRET=

# URL do app que recebe os webhooks (message.sent, message.failed, message.received, session.disconnected)
APP_WEBHOOK_URL=

# Identificador da sessão Baileys (permite rodar múltiplas sessões trocando esse valor)
BRIDGE_SESSION_ID=default

PORT=3333
